@model IEnumerable<Cocktail>

@{
    ViewData["Title"] = "Menu";
}

<div class="menu-page">
    <h1>Menu</h1>

    <div class="cocktails">
        @foreach (var item in Model)
        {
            <div class="cocktail">
                <h3>@item.Name</h3>
                <p>$@item.Price.ToString("F2")</p>

                <form class="order-form" asp-controller="Order" asp-action="PlaceOrder" method="post">

                    <input type="hidden" name="cocktailId" value="@item.Id" />

                    <button class="order-button" type="submit"> Order </button>

                </form>
            </div>
        }
    </div>
</div>