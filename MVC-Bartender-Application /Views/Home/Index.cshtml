@{
    ViewData["Title"] = "Home Page";
}

<div class="home-page">
    <div class="home-page-header">
        <h1>Welcome</h1>
        <p>Select an option:</p>
    </div>

    <div class="home-options">
        <a class="home-option" asp-controller="Order" asp-action="Menu">
            <strong>Menu:</strong>
            <span>View a menu of cocktails and place an order</span>
        </a>

        <a class="home-option" asp-controller="Order" asp-action="Queue">
            <strong>Order Queue:</strong>
            <span>List of cocktail orders</span>
        </a>
    </div>
</div>
